{
  "functions": {
    "api/generate.js": { "maxDuration": 60 },
    "api/upload.js": { "maxDuration": 30 },
    "api/ppt.js": { "maxDuration": 30 }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "yoonjeongho-ax.vercel.app" }],
      "destination": "https://yoonjungho.vercel.app/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "yoonjeongho-ax.vercel.app" }],
      "destination": "https://yoonjungho.vercel.app/:path*",
      "permanent": false
    }
  ]
}
